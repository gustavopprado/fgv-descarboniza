# ---------------------------------------------------------------------------
# Copie para .env e preencha com os valores reais. O .env está no .gitignore.
# NENHUM valor real entra neste arquivo. Ele é versionado e público.
#
# Duas regras que valem para o arquivo inteiro:
#
#  1. Nada de credencial, nem "só para testar": este arquivo tem exatamente o
#     formato de um arquivo de segredos, e é o que o torna perigoso. Já houve
#     duas tentativas de preenchê-lo com a chave real (§14). Um teste e um
#     gancho de pré-commit vigiam isso.
#  2. **Placeholder plausível é pior que vazio.** Onde um valor de exemplo
#     passaria por valor real e produziria número errado em silêncio, o exemplo
#     é VAZIO — o código recusa rodar sem o valor, e recusar é mais seguro que
#     calcular a partir de um palpite.
#
# Só a configuração pública do SDK web é NEXT_PUBLIC_. Nenhuma credencial e
# nenhum dado de pessoa pode virar NEXT_PUBLIC_ (CLAUDE.md §11.2).
# ---------------------------------------------------------------------------

# Firebase — servidor -----------------------------------------------------
# Credencial do Admin SDK. Só no servidor, nunca exposta ao cliente (§11.2).
# Duas formas; a primeira é a que funciona na Vercel, que não tem disco.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# A chave é uma linha só, com as quebras escapadas como \n literal; o código
# desfaz isso antes de entregar ao Admin SDK.
FIREBASE_PRIVATE_KEY=""
# Alternativa local: caminho do JSON da service account, que NUNCA é versionado.
# GOOGLE_APPLICATION_CREDENTIALS="../fora-do-repositorio/service-account.json"

# Firebase — cliente, só autenticação -------------------------------------
# Configuração pública do SDK web. Não é credencial, mas carrega o id do projeto,
# que é identificador de infraestrutura e não se versiona (§2.1). O navegador usa
# isso apenas para provar quem é: ele nunca consulta o Firestore (§11.2).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Dica de domínio na tela de escolha de conta do Google. É só dica: a restrição
# de verdade é a do servidor, abaixo.
NEXT_PUBLIC_WORKSPACE_DOMINIO=""

# Autenticação ------------------------------------------------------------
# Firebase Auth com provedor Google, restrito ao domínio corporativo (§11.4).
# O servidor recusa qualquer conta fora deste domínio antes de emitir cookie.
GOOGLE_WORKSPACE_DOMINIO=""

# Mobilidade --------------------------------------------------------------
# Origem dos deslocamentos. Parâmetro de ambiente, nunca constante no código
# (§6.2). VAZIO de propósito: "0.0000 / 0.0000" é uma coordenada válida no
# Golfo da Guiné, e uma carga rodada a partir dela mediria a distância de todo
# mundo até o oceano — erro que vira exceção em massa e não estoura em lugar
# nenhum (§14, 14/09).
FABRICA_LATITUDE=""
FABRICA_LONGITUDE=""
# Dias úteis por mês usados no cálculo (ida e volta por dia).
MOBILIDADE_DIAS_UTEIS_MES="21"
# Recorte com menos pessoas que isso não é exibido; vira "outros" (§3.1).
MOBILIDADE_SUPRESSAO_MINIMA="5"
# Ano-base da pesquisa a ser carregada. Vazio: carregar o ano errado sobrescreve
# o ano-base inteiro, e a recarga é por escopo.
MOBILIDADE_ANO_BASE=""
# Distância usada no deslocamento: rodoviaria | ortodromica. A escolha muda o
# número do inventário e é declarada na tela de método. Em "rodoviaria" vale o
# ROTAS_PROVEDOR configurado abaixo.
MOBILIDADE_DISTANCIA_MODO="rodoviaria"
# Acima disso o deslocamento diário não se sustenta e a resposta vira exceção,
# fora da média e listada no método (§6.2).
MOBILIDADE_DISTANCIA_MAXIMA_KM="150"
# Geocodificação a partir do CEP. O endereço é descartado depois do cálculo
# e nunca é persistido — nem em staging, log, cache ou arquivo temporário.
# Provedor: google | brasilapi | nominatim. Só o CEP sai da máquina.
#
# Use "google". As alternativas gratuitas foram testadas contra a base real e
# devolvem a coordenada do MUNICÍPIO para a maioria dos CEPs: dezenas de
# endereços viram o mesmo ponto, a distância deixa de medir deslocamento e o
# módulo fecha por dentro sem ninguém perceber. Ver §14.
GEOCODE_PROVEDOR="google"
# Chave restrita à Geocoding API. Separada da chave de rotas de propósito:
# restrição por API derruba a chamada da outra ponta se as duas forem a mesma.
GEOCODE_API_KEY=""
# Identificação enviada ao Nominatim, exigida pelo uso do serviço.
GEOCODE_USER_AGENT="fgv-descarboniza/1.0 (contato@exemplo.invalid)"

# Viagens -----------------------------------------------------------------
# NÃO EXISTE data de corte entre agência e formulário, e a ausência é
# deliberada (§0.1). O inventário de viagens tem duas fontes, ambas
# administrativas — o relatório da agência e a planilha do cartão empresarial —,
# que cobrem o mesmo tipo de registro e somam sem ressalva. O formulário do
# viajante alimenta o programa de viagens, que é outro sistema, com coleção e
# telas próprias. Se você encontrar VIAGENS_CORTE_FONTE em algum .env, pode
# apagar: ninguém mais lê.
#
# Ano que o inventário de viagens relata. O trecho entra pelo ano do VOO, não
# pelo da emissão da passagem: há passagem comprada num ano com voo no seguinte,
# e trecho de outro ano pertence ao relatório daquele ano (§7).
#
# VAZIO de propósito: um ano de exemplo aqui carregaria o período errado sem
# nenhum erro aparecer. As cargas recusam rodar sem o valor.
VIAGENS_ANO_BASE=""
# Vigência atribuída aos fatores aéreos carregados por scripts/seed-fatores.ts.
# Vazio: vigência errada faz o resolvedor escolher outro fator sem avisar.
FATORES_VIGENCIA_INICIO=""
# Provedor de distância rodoviária: google | ors (§7.4).
#
# Use "google". O plano gratuito do OpenRouteService tem cota diária pequena
# demais para recarregar a pesquisa mais de uma vez no mesmo dia — e cota
# esgotada derruba a carga inteira. Ver §14.
ROTAS_PROVEDOR="google"
# Intervalo entre chamadas de rota, em ms. Serve para respeitar o limite por
# minuto do provedor; o padrão do código já é conservador para cada um deles.
# ROTAS_INTERVALO_MS="1600"
# Chave restrita à Routes API, separada da chave de geocodificação.
#
# Esta é a chave das CARGAS: ela roda da máquina de quem opera, onde o IP é
# estável, e por isso admite restrição por IP além da restrição por API.
GOOGLE_ROUTES_API_KEY=""
OPENROUTESERVICE_API_KEY=""
# Chave da APLICAÇÃO, usada pelo formulário do programa de viagens (§11.8).
#
# Separada da de cima porque o destino é outro: esta sai da Vercel, cujo IP não
# é estável, então a restrição possível é por API mais teto de faturamento com
# alerta. Uma chave só obrigaria a abandonar a restrição por IP das cargas.
# Sem ela, o formulário cai na chave das cargas — conveniente em
# desenvolvimento, e não é o que deve ir para produção.
GOOGLE_ROUTES_API_KEY_APP=""

# Programa de viagens (§7.5) ----------------------------------------------
#
# NÃO é inventário. Coleção própria, telas próprias, e nada daqui entra em
# consulta, indicador, série ou mapa do inventário (§0.1).
#
# Quantas pessoas o programa poderia alcançar — o denominador da adesão.
# Vazio: não sai de coleção nenhuma. O tamanho da coleção de funcionários seria
# o candidato óbvio e está errado, porque ela inclui quem só aparece como
# aprovador de passagem. Sem valor, a tela mostra a contagem e declara que o
# denominador não está definido, em vez de exibir proporção inventada (§13).
PROGRAMA_QUADRO=""
# Até quando o período está fechado, em AAAA-MM-DD. Viagem com data de ida até
# esta data, inclusive, fica somente leitura.
# Vazio: nada fechado, tudo editável — que é o estado inicial. Fechar é
# operação, feita aqui e fora da aplicação, como conceder perfil e rodar carga.
PROGRAMA_FECHADO_ATE=""

# Marítimo ----------------------------------------------------------------
#
# A base de data NÃO é variável de ambiente. A §8.3 manda escolher uma das duas
# bases do relatório e declarar qual é; a escolha está feita — o ETD do primeiro
# carregamento — e a outra não tem caminho no código, porque só existe na aba de
# resumo, que é agregada. Variável que só aceita um valor não configura nada, e
# uma que aceitasse o outro valor prometeria comportamento que o código não tem.
# Ver MARITIMO_BASE_DE_DATA em src/lib/env.ts.
#
# Os três abaixo são parâmetro declarado, não constante no código (§8.1.1), e
# **vêm vazios de propósito**: a carga recusa rodar sem eles, e um valor de
# exemplo aqui é pior que nenhum. Os dois limiares decidem o que é marcado e o
# que não é importado — um número plausível neste arquivo público viraria, em
# silêncio, um alerta que não dispara ou uma linha recusada sem motivo. Os
# valores em vigor moram no `.env`, e a tela de método os declara.
#
# Razão contra a mediana do CORREDOR acima da qual a linha recebe alerta. Ela
# continua no total: atípico é contêiner pouco carregado ou carga solta, que é
# emissão verdadeira. Escolha-o folgado e **meça a fração da base que ele
# marcaria** — alerta que dispara em boa parte das linhas é alerta que se
# aprende a ignorar.
MARITIMO_LIMIAR_ATIPICO=""
# Razão contra a mediana GERAL do módulo acima da qual a linha NÃO é importada.
# Outra regra, outro limiar: aqui o sintoma é fórmula errada na origem, e um
# número desses sozinho domina o total. A comparação não pode ser por corredor —
# linha impossível costuma estar sozinha no corredor dela. Escolha-o com folga
# sobre a maior linha legítima da base; alto demais só pega o absurdo, e fórmula
# errada em embarque pequeno passa por baixo.
MARITIMO_LIMIAR_IMPOSSIVEL=""
# Quantos embarques medidos um corredor precisa ter para servir de referência,
# na estimativa e na sinalização. Abaixo disso a "média do corredor" seria uma
# observação só, e a mediana dele seria a própria linha que se quer comparar.
MARITIMO_AMOSTRA_MINIMA_CORREDOR=""

# Scripts de carga --------------------------------------------------------
# Caminhos locais das bases. As bases NÃO são versionadas (§2.1).
BASE_VIAGENS_PATH="dados/base_viagens.json"
BASE_MOBILIDADE_PATH="dados/mobilidade.xlsx"
# Planilha de viagens pagas no cartão empresarial — terceira fonte das viagens
# (§7). Fonte separada da agência: recarregar uma não encosta na outra.
BASE_CARTAO_PATH="dados/cartao-viagens.xlsx"
# Fatores da mobilidade: arquivo que você monta com a fonte adotada.
BASE_FATORES_MOBILIDADE_PATH="dados/fatores_mobilidade.json"
# Relatório do agente de carga. Precisa ser .xlsx: o leitor do projeto não abre
# o formato antigo do Excel, e converter é passo de quem opera a carga.
BASE_MARITIMO_PATH="dados/relatorio-maritimo.xlsx"
# Lista oficial UN/LOCODE, que dá coordenada e função a cada código de porto.
# Genérica e pública, mas não versionada: filtrá-la para os códigos desta base
# produziria a lista de onde a empresa importa (§2.2). `npm run seed:portos`
# baixa o arquivo se ele não estiver aqui.
BASE_UNLOCODE_PATH="dados/unlocode-code-list.csv"
# Tolerância, em kg, na comparação de scripts/verificar.ts.
VERIFICAR_TOLERANCIA_KG="0.1"

# Desenvolvimento ---------------------------------------------------------
# Origens, além de localhost, que podem alcançar os recursos de desenvolvimento
# do Next — é o que permite abrir o sistema pelo IP da máquina e conferir o
# layout num celular de verdade. Separadas por vírgula, **sem esquema e sem
# porta**: "192.168.0.10", não "http://192.168.0.10:3000".
#
# Vazio é o estado normal: só localhost. Sem a origem aqui, o Next recusa servir
# /_next/* para ela, o JavaScript não carrega e a tela vira HTML inerte — botão
# que não responde, sem erro em lugar nenhum. O sintoma não se parece com a
# causa, então o valor fica declarado aqui em vez de escrito no código: é IP de
# máquina, e IP de máquina não se versiona (§2.1).
#
# Vale só em desenvolvimento. Em produção o Next ignora.
DEV_ORIGENS_PERMITIDAS=""
