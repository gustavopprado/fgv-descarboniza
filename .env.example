# ---------------------------------------------------------------------------
# Copie para .env e preencha com os valores reais. O .env está no .gitignore.
# TODOS os valores abaixo são fictícios, de exemplo. Nenhum deles é real.
# Só a configuração pública do SDK web é NEXT_PUBLIC_. Nenhuma credencial e
# nenhum dado de pessoa pode virar NEXT_PUBLIC_ (CLAUDE.md §11.2).
# ---------------------------------------------------------------------------

# Firebase — servidor -----------------------------------------------------
# Credencial do Admin SDK. Só no servidor, nunca exposta ao cliente (§11.2).
# Duas formas; a primeira é a que funciona na Vercel, que não tem disco.
FIREBASE_PROJECT_ID="projeto-ficticio-de-exemplo"
FIREBASE_CLIENT_EMAIL="conta-ficticia@projeto-ficticio-de-exemplo.iam.gserviceaccount.com"
# A chave é uma linha só, com as quebras escapadas como \n literal; o código
# desfaz isso antes de entregar ao Admin SDK.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHAVE-FICTICIA-DE-EXEMPLO\n-----END PRIVATE KEY-----\n"
# Alternativa local: caminho do JSON da service account, que NUNCA é versionado.
# GOOGLE_APPLICATION_CREDENTIALS="../fora-do-repositorio/service-account.json"

# Firebase — cliente, fase de autenticação --------------------------------
# Configuração pública do SDK web. Não é credencial, mas carrega o id do projeto,
# que é identificador de infraestrutura e não se versiona (§2.1).
NEXT_PUBLIC_FIREBASE_API_KEY="chave-ficticia-de-exemplo"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="projeto-ficticio-de-exemplo.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="projeto-ficticio-de-exemplo"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:exemplo"

# Autenticação ------------------------------------------------------------
# Firebase Auth com provedor Google, restrito ao domínio corporativo (§11.4).
GOOGLE_WORKSPACE_DOMINIO="exemplo.invalid"
# Segredo do cookie de sessão emitido pelo servidor após verificar o ID token.
AUTH_SESSION_SECRET="troque-por-uma-string-aleatoria-longa"

# Mobilidade --------------------------------------------------------------
# Origem dos deslocamentos. Parâmetro de ambiente, nunca constante no código
# (§6.2). Os valores abaixo são um ponto qualquer, sem relação com a fábrica.
FABRICA_LATITUDE="0.0000"
FABRICA_LONGITUDE="0.0000"
# Dias úteis por mês usados no cálculo (ida e volta por dia).
MOBILIDADE_DIAS_UTEIS_MES="21"
# Recorte com menos pessoas que isso não é exibido; vira "outros" (§3.1).
MOBILIDADE_SUPRESSAO_MINIMA="5"
# Ano-base da pesquisa a ser carregada.
MOBILIDADE_ANO_BASE="2026"
# Distância usada no deslocamento: rodoviaria | ortodromica. A escolha muda o
# número do inventário e é declarada na tela de método. Em "rodoviaria" vale o
# ROTAS_PROVEDOR configurado abaixo.
MOBILIDADE_DISTANCIA_MODO="rodoviaria"
# Acima disso o deslocamento diário não se sustenta e a resposta vira exceção,
# fora da média e listada no método (§6.2).
MOBILIDADE_DISTANCIA_MAXIMA_KM="150"
# Geocodificação a partir do CEP. O endereço é descartado depois do cálculo
# e nunca é persistido — nem em staging, log, cache ou arquivo temporário.
# Provedor: brasilapi | nominatim | google. Só o CEP sai da máquina.
GEOCODE_PROVEDOR="brasilapi"
GEOCODE_API_KEY="chave-ficticia-de-exemplo"
# Identificação enviada ao Nominatim, exigida pelo uso do serviço.
GEOCODE_USER_AGENT="fgv-descarboniza/1.0 (contato@exemplo.invalid)"

# Viagens -----------------------------------------------------------------
# A partir desta data do voo a fonte oficial é o formulário do viajante (§7).
VIAGENS_CORTE_FONTE="2026-10-01"
# Vigência atribuída aos fatores aéreos carregados por scripts/seed-fatores.ts.
FATORES_VIGENCIA_INICIO="2025-01-01"
# Provedor de distância rodoviária: google | ors (§7.4).
ROTAS_PROVEDOR="ors"
# Intervalo entre chamadas de rota, em ms. O plano gratuito do OpenRouteService
# aceita 40 por minuto; o padrão do código fica abaixo disso. Só reduza se o seu
# plano permitir — estourar o limite custa tempo, não dinheiro, mas custa.
# ROTAS_INTERVALO_MS="1600"
GOOGLE_ROUTES_API_KEY="chave-ficticia-de-exemplo"
OPENROUTESERVICE_API_KEY="chave-ficticia-de-exemplo"

# Scripts de carga --------------------------------------------------------
# Caminhos locais das bases. As bases NÃO são versionadas (§2.1).
BASE_VIAGENS_PATH="dados/base_viagens.json"
BASE_MOBILIDADE_PATH="dados/mobilidade.xlsx"
# Fatores da mobilidade: arquivo que você monta com a fonte adotada.
BASE_FATORES_MOBILIDADE_PATH="dados/fatores_mobilidade.json"
BASE_MARITIMO_PATH="dados/relatorio_co2.xls"
# Tolerância, em kg, na comparação de scripts/verificar.ts.
VERIFICAR_TOLERANCIA_KG="0.1"
